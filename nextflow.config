manifest {
    name = 'fqdup-qc-nextflow'
    description = 'fqdup QC: paired-end merge, pre-dedup damage profile, sort and dereplication, post-dedup damage profile'
    version = '0.1.0'
    nextflowVersion = '>=25.10'
}

process {
    errorStrategy = 'terminate'
    maxRetries = 0
}
executor.queueSize = 4

profiles {
    test {
        params.manifest = "${projectDir}/test/samples.tsv"
        process {
            executor = 'local'
            withName: 'MERGE_RAW' { cpus = 1; memory = '1 GB' }
            withName: 'PROFILE_PRE' { cpus = 1; memory = '1 GB' }
            withName: 'SORT_DEREP' { cpus = 1; memory = '1 GB' }
            withName: 'PROFILE_POST' { cpus = 1; memory = '1 GB' }
        }
    }
    slurm {
        process.executor = 'slurm'
        executor.queueSize = 50
    }
}
